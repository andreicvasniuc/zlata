# Production-like image for running the app locally the way Heroku runs it (RAILS_ENV=production,
# no development/test gems, no source bind mount). Heroku itself builds with the classic Ruby
# buildpack and does not use this file.
FROM ruby:4.0.9-slim AS build

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential git libyaml-dev \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV BUNDLE_WITHOUT="development:test" \
    BUNDLE_FROZEN="true"

COPY Gemfile Gemfile.lock ./
RUN bundle install \
 && rm -rf /usr/local/bundle/cache /usr/local/bundle/ruby/*/cache


FROM ruby:4.0.9-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends libyaml-0-2 \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --uid 1000 rails

WORKDIR /app
ENV RAILS_ENV=production \
    BUNDLE_WITHOUT="development:test" \
    BUNDLE_FROZEN="true"

COPY --from=build /usr/local/bundle /usr/local/bundle
COPY --chown=rails:rails Gemfile Gemfile.lock Rakefile config.ru Procfile ./
COPY --chown=rails:rails app ./app
COPY --chown=rails:rails bin ./bin
COPY --chown=rails:rails config ./config
COPY --chown=rails:rails db ./db
COPY --chown=rails:rails lib ./lib
COPY --chown=rails:rails public ./public
RUN mkdir -p log tmp/cache tmp/pids && chown -R rails:rails log tmp

USER rails
EXPOSE 3000

# same command as the Procfile
CMD ["bundle", "exec", "puma", "-C", "config/puma.rb"]
